#!/usr/bin/env bash
#
# Stop a photo with metadata in it from being committed. See tools/check-photos
# for why. Git does not run hooks from a clone until it is told to, once:
#
#   git config core.hooksPath .githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

STAGED=()
while IFS= read -r -d '' F; do
    case "$(printf '%s' "${F##*.}" | tr '[:upper:]' '[:lower:]')" in
        jpg|jpeg|png|webp|heic|heif|tif|tiff) STAGED+=("$F") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[[ "${#STAGED[@]}" -gt 0 ]] || exit 0

tools/check-photos "${STAGED[@]}" || {
    printf '\ncommit refused: fix the photos above, stage them again, and commit.\n' >&2
    exit 1
}

#!/usr/bin/env python3
"""Turn a profile into a solid of revolution and write it as an STL to print.

    tools/revolve-stl <out.stl> <radius,z> <radius,z> ...

All dimensions in millimetres. The profile is the outline of half the
section, given in order from one end of the axis to the other; it is closed
back along the axis by the first and last points, so start and finish it at
radius 0 for a solid, or give an inner profile as well for a bore:

    tools/revolve-stl plug.stl 0,0 5,0 5,20 3,20 3,30 0,30

This exists for space models: a plain turned shape, printed to try in a
spindle before anything is bought or made in steel. It needs nothing but
Python, and it proves its own output before writing it - every edge shared by
exactly two triangles, and the volume agreeing with the profile's - because a
model that slices wrongly wastes a print and a model of the wrong size wastes
a collet.
"""
import math
import struct
import sys

SEGMENTS = 180


def fail(msg):
    print(f"revolve-stl: {msg}", file=sys.stderr)
    sys.exit(1)


def parse(args):
    pts = []
    for a in args:
        try:
            r, z = (float(v) for v in a.split(","))
        except ValueError:
            fail(f"not a radius,z pair: {a}")
        if r < 0:
            fail(f"negative radius: {a}")
        pts.append((r, z))
    if len(pts) < 3:
        fail("a profile needs at least three points")
    return pts


def revolve(profile, n=SEGMENTS):
    """Triangles for the closed loop of profile points swept round the axis."""
    loop = profile + [profile[0]]
    tris = []
    ring = [(math.cos(2 * math.pi * k / n), math.sin(2 * math.pi * k / n)) for k in range(n)]
    for (r0, z0), (r1, z1) in zip(loop, loop[1:]):
        if r0 == 0 and r1 == 0:
            continue                      # a length of the axis itself: no surface
        for k in range(n):
            c0, s0 = ring[k]
            c1, s1 = ring[(k + 1) % n]
            a = (r0 * c0, r0 * s0, z0)
            b = (r0 * c1, r0 * s1, z0)
            c = (r1 * c1, r1 * s1, z1)
            d = (r1 * c0, r1 * s0, z1)
            # A point on the axis collapses one side of the quad, so it is one
            # triangle and not two, or the mesh would carry slivers of no area.
            if r0 == 0:
                tris.append((a, c, d))
            elif r1 == 0:
                tris.append((a, b, c))
            else:
                tris.append((a, b, c))
                tris.append((a, c, d))
    return tris


def volume(tris):
    """Signed volume by summing tetrahedra to the origin."""
    v = 0.0
    for a, b, c in tris:
        v += (a[0] * (b[1] * c[2] - b[2] * c[1])
              - a[1] * (b[0] * c[2] - b[2] * c[0])
              + a[2] * (b[0] * c[1] - b[1] * c[0])) / 6.0
    return v


def profile_volume(profile, n=SEGMENTS):
    """What the volume should be: the swept area of the n-sided approximation."""
    loop = profile + [profile[0]]
    area_factor = n * math.sin(2 * math.pi / n) / 2          # polygon for pi
    v = 0.0
    for (r0, z0), (r1, z1) in zip(loop, loop[1:]):
        v += (z1 - z0) * (r0 * r0 + r0 * r1 + r1 * r1) / 3.0
    return abs(v) * area_factor


def check(tris, profile):
    edges = {}
    key = lambda p: (round(p[0], 6), round(p[1], 6), round(p[2], 6))
    for t in tris:
        ks = [key(p) for p in t]
        for i in range(3):
            e = tuple(sorted((ks[i], ks[(i + 1) % 3])))
            edges[e] = edges.get(e, 0) + 1
    open_edges = sum(1 for c in edges.values() if c != 2)
    if open_edges:
        fail(f"the mesh is not closed: {open_edges} edges are not shared by exactly two triangles")
    got, want = abs(volume(tris)), profile_volume(profile)
    if want == 0 or abs(got - want) / want > 1e-6:
        fail(f"volume {got:.3f} mm3 does not agree with the profile's {want:.3f} mm3")
    return got


def write(path, tris, flip):
    with open(path, "wb") as f:
        f.write(b"swarf revolve-stl".ljust(80, b" "))
        f.write(struct.pack("<I", len(tris)))
        for a, b, c in tris:
            if flip:
                b, c = c, b
            u = [b[i] - a[i] for i in range(3)]
            w = [c[i] - a[i] for i in range(3)]
            nrm = [u[1] * w[2] - u[2] * w[1], u[2] * w[0] - u[0] * w[2], u[0] * w[1] - u[1] * w[0]]
            m = math.sqrt(sum(x * x for x in nrm)) or 1.0
            f.write(struct.pack("<12fH", *(x / m for x in nrm), *a, *b, *c, 0))


def main():
    if len(sys.argv) < 5:
        print(__doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        sys.exit(2)
    out, profile = sys.argv[1], parse(sys.argv[2:])
    tris = revolve(profile)
    vol = check(tris, profile)
    # Outward-facing triangles enclose a positive volume; a profile given the
    # other way round comes out inside-out, so it is turned over here.
    write(out, tris, flip=volume(tris) < 0)
    zs = [z for _, z in profile]
    print(f"{out}: {len(tris)} triangles, {max(r for r, _ in profile) * 2:.3f} mm across, "
          f"{max(zs) - min(zs):.3f} mm long, {vol / 1000:.2f} cm3, closed")


if __name__ == "__main__":
    main()
